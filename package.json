{
  "name": "@1337exp/taoeditor",
  "version": "0.2.0",
  "description": "Embeddable rich-text editor for comments, chats, notes and articles",
  "keywords": [
    "editor",
    "rich-text",
    "wysiwyg",
    "prosemirror",
    "vue",
    "vue3",
    "comments",
    "chat",
    "mentions",
    "typescript",
    "taoui",
    "taoux"
  ],
  "author": "1337exp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1337exp/taoeditor.git"
  },
  "homepage": "https://github.com/1337exp/taoeditor#readme",
  "bugs": {
    "url": "https://github.com/1337exp/taoeditor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./vue/taoui": {
      "types": "./dist/vue/taoui/index.d.ts",
      "import": "./dist/vue-taoui.js"
    },
    "./content.css": "./dist/content.css",
    "./editor.css": "./dist/editor.css",
    "./taoui.css": "./dist/taoui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.json && vue-tsc --noEmit -p demo/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "mutate": "node scripts/mutate.mjs . scripts/mutations.json",
    "dev:lan": "vite --host",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "screenshot": "node scripts/screenshot.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.6.0",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.5",
    "prosemirror-view": "1.42.9"
  },
  "peerDependencies": {
    "@1337exp/taoui": "^5.31.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "@1337exp/taoui": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@1337exp/taoui": "^5.31.0",
    "@1337exp/taoux": "^0.9.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  }
}
